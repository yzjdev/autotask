<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Shizuku 多进程 binder 共享依赖隐式广播(ShizukuProvider.ACTION_BINDER_RECEIVED)。
        本应用为单进程且未调用 enableMultiProcessSupport,此项仅为保守保留。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BROADCASTS" />

    <!--
        WRITE_SECURE_SETTINGS:写入 Secure 设置(含无障碍开关)所需。
        本应用不能自行授予此权限,必须由 ADB / shell 执行 pm grant,
        而 pm grant 的前提是权限已声明在本 manifest 中。
        AOSP 会拒绝授予未声明的权限:
          PermissionManagerService.grantRuntimePermission →
            "Package X has not requested permission WRITE_SECURE_SETTINGS"
        本应用此前未声明此项,因此 Shizuku 执行的 pm grant 必然失败,
        表现为「以为开了权限,应用却检测到未授权」。
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!--
        getActivityInfo 校验目标应用任意 Activity 需要 packages 查询权限
        (Android 11+ package visibility):否则对所有未声明可见性的应用抛
        NameNotFoundException,gkd 的 isActivity 同款校验也会全部失效。
        参考 gkd-app/AndroidManifest.xml 的做法,直接声明 QUERY_ALL_PACKAGES。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        INTERNET:远程订阅(updateUrl)拉取订阅 JSON5 所需,GKD 订阅功能同款。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        SYSTEM_ALERT_WINDOW 已移除:悬浮窗(OverlayDebugWindow/OverlayToggleWindow/
        showPixelOverlay)全部使用 TYPE_ACCESSIBILITY_OVERLAY,属于无障碍服务
        自带能力,不需要悬浮窗权限,也无需 canDrawOverlays。
    -->

    <!--
        REQUEST_IGNORE_BATTERY_OPTIMIZATIONS:主页「权限管理」卡片直接拉起
        「忽略电池优化」授权弹窗(ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS)所需,
        用户确认后本应用进入系统电池优化白名单,避免后台任务被杀。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".AutoGkdApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoGkd">

        <!--
            Shizuku 静态授权入口,配置与官方示例 dev.rikka.shizuku.demo 逐字对齐
            (见官方仓库 RikkaApps/Shizuku-API 的 demo/src/main/AndroidManifest.xml)。
            注意:dev.rikka.shizuku:provider 的 AAR manifest 只声明了 application 级
            meta-data,并不会自动合并 <provider>,这里必须手动声明,否则 Shizuku
            服务端(adb/shell)无法把 binder 送进来,Shizuku 永远连不上。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            崩溃页:由 CrashReporter 在崩溃时通过 startActivity 拉起。
            独立 :crash 进程:主进程崩溃退出后崩溃页进程仍存活,
            复制日志/查看详情不再受主进程死亡影响。
            exported=false,因为它只由本应用进程内部拉起,不需要外部可见;
            若声明为导出,任意第三方都能伪造崩溃页。
        -->
        <activity
            android:name=".crash.CrashActivity"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AutoGkd" />

        <!-- 无障碍服务: manifest 注册 SelectToSpeakService(系统级服务名,绕过部分
             应用的混淆节点/服务名校验),实际业务逻辑在其父类 DramaAccessibilityService 中 -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="ExportedService">
            <intent-filter android:priority="10000">
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
