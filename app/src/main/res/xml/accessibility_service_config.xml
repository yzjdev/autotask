<?xml version="1.0" encoding="utf-8"?>
<!--
    取自 GKD(gkd-kit/gkd)的 gkd-android/src/main/res/xml/a11y_info.xml,三处按本项目调整:
      accessibilityEventTypes —— 用 typeAllMask:规则引擎的 watchEvents 与事件日志悬浮窗
        依赖点击/文本等全量事件,gkd 只收窗口变化两类会收不到;
      description / isAccessibilityTool —— gkd 引用 @string/a11y_desc、@bool/is_accessibility_tool,
        本项目没有,改用已有的描述字符串并内联 true;
      settingsActivity —— gkd 指向 li.gkd.app.MainActivity,这里指向本应用主页。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackAllMask"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagDefault|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:isAccessibilityTool="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.yzjdev.autotask.MainActivity"
    tools:ignore="UnusedAttribute" />
