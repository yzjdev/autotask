<?xml version="1.0" encoding="utf-8"?>
<!--
    无障碍服务配置:参考 assists 框架(ven-coder/assists)的 assists_service.xml,
    补齐 flagRetrieveInteractiveWindows / flagIncludeNotImportantViews 等增强能力,
    同时保留本应用需要的事件类型与手势能力。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewFocused|typeViewTextChanged|typeViewClicked|typeViewLongClicked"
    android:accessibilityFeedbackType="feedbackAllMask"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:settingsActivity="com.example.composedemo.MainActivity"
    android:description="@string/accessibility_service_description" />
