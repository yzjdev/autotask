<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <string name="app_name">自动化助手</string>
    <string name="accessibility_service_label">自动化助手无障碍服务</string>
    <string name="accessibility_service_description">用于读取界面控件、定位按钮并模拟点击,以便自动执行任务。</string>

    <!-- 写入安全设置权限已授权 -->
    <string name="status_secure_granted">已授权,可读写无障碍开关。</string>

    <!-- 写入安全设置权限未授权:说明它与「修改系统设置」是两个不同权限 -->
    <string name="status_need_secure">需通过 ADB / Shizuku 授权。</string>

    <!-- 无障碍服务已开启 -->
    <string name="status_service_running">服务运行中。</string>

    <!-- 无障碍服务未开启 -->
    <string name="status_service_disabled">用于模拟点击与读取界面控件。</string>

    <!-- Shizuku 服务已连接 -->
    <string name="status_shizuku_ready">已连接,可代授安全设置权限。</string>

    <!-- Shizuku 服务未连接 -->
    <string name="status_shizuku_unready">未连接,请启动 Shizuku 服务。</string>

    <!-- Shizuku 授权弹窗被拒绝 -->
    <string name="status_shizuku_denied">已取消 Shizuku 授权,本次未连接。</string>

    <!-- Shizuku 代授已发起 -->
    <string name="status_secure_granting">正在通过 Shizuku 申请「写入安全设置」权限…</string>

    <!-- Shizuku 代授失败 -->
    <string name="status_secure_failed">Shizuku 未能授予「写入安全设置」权限,请检查 Shizuku 服务是否运行。</string>

    <string name="label_shizuku">Shizuku 服务</string>
    <string name="label_secure_settings">写入安全设置权限</string>
    <string name="label_accessibility">无障碍服务</string>
    <string name="label_status">当前状态</string>

    <string name="action_open_settings">打开无障碍设置</string>
    <string name="action_request_shizuku">申请 Shizuku</string>
    <string name="action_grant_secure">授予安全设置</string>
    <string name="action_enable_service">开启无障碍</string>
    <string name="action_disable_service">关闭无障碍</string>

    <string name="msg_accessibility_disabled">无障碍服务未开启,正在跳转系统设置…</string>
    <string name="msg_accessibility_running">无障碍服务正在运行,无需重新开启。</string>

    <!-- ==================== 确认弹窗 ==================== -->
    <!-- 确认跳转系统无障碍设置页(缺「写入安全设置」权限时使用) -->
    <string name="confirm_a11y_title">是否跳转无障碍设置?</string>
    <string name="confirm_a11y_message">当前缺少「写入安全设置」权限,应用无法自动开启无障碍服务。\n\n点击「继续」将跳转到系统无障碍设置页,请手动开启「自动化助手无障碍服务」。</string>
    <string name="confirm_ok">继续</string>
    <string name="confirm_cancel">取消</string>

    <!-- ==================== 崩溃页 ==================== -->
    <string name="crash_warning_symbol">⚠</string>
    <string name="crash_title">应用发生异常</string>
    <string name="crash_subtitle">程序遇到了问题。你可以复制日志以便排查,或重启应用。</string>
    <string name="crash_detail_time">时间: %1$s</string>
    <string name="crash_detail_device">设备: %1$s · API %2$d</string>
    <string name="crash_detail_version">版本: %1$s (%2$d)</string>
    <string name="crash_detail_thread">线程: %1$s</string>
    <string name="crash_no_stack">无堆栈信息</string>
    <string name="crash_action_copy">复制日志</string>
    <string name="crash_action_restart">重启应用</string>
    <string name="crash_action_exit">退出</string>
    <string name="crash_copy_done">崩溃日志已复制到剪贴板</string>
    <string name="crash_copy_failed">复制失败</string>
    <!-- 红色错误卡片提示:点按/长按复制 -->
    <string name="crash_hint_tap_copy">点按复制错误信息</string>
    <!-- 元信息行(键左值右布局,键在代码里,值含动态参数) -->
    <string name="crash_detail_device_value">%1$s · API %2$d</string>
    <string name="crash_detail_version_value">%1$s (%2$d)</string>
